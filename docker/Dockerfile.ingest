FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /repo
COPY DataLake.sln .
COPY src/ src/
RUN dotnet restore src/DataLake.Ingest.Worker/DataLake.Ingest.Worker.csproj
RUN dotnet publish src/DataLake.Ingest.Worker/DataLake.Ingest.Worker.csproj \
    -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT ["dotnet", "DataLake.Ingest.Worker.dll"]
